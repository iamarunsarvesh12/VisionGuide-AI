# ==============================================================================
# VisionGuide AI — Environment Configuration Template
# ==============================================================================
# NOTE: VisionGuide AI is designed to operate 100% OFFLINE on local hardware.
# No external cloud services, API keys, or remote authentication are required.
# ==============================================================================

# Application Execution Mode (development / production)
VG_ENV=production

# Logging Level (INFO / DEBUG / WARNING / ERROR)
VG_LOG_LEVEL=INFO

# Optional: Preferred Video Device Index (Default: 0 for built-in webcam)
VG_CAMERA_INDEX=0
